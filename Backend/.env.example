# Server
PORT=5000
CLIENT_URL=http://localhost:5173

# Database — local or MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/shopnest

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRE=7d

# Razorpay (dashboard -> Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

# Cloudinary (for product image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Nodemailer (use a Gmail App Password or SMTP provider like Brevo/Mailtrap)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# Seed admin account
ADMIN_EMAIL=admin@shopnest.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=ShopNest Admin
